{
  "name": "look-busy",
  "displayName": "Look Busy",
  "description": "Pretend to look busy while AI writes your code",
  "publisher": "AbdullahHassan",
  "version": "0.0.1",
  "icon": "media/look-busy-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdullahHassan192/look-busy.git"
  },
  "homepage": "https://github.com/AbdullahHassan192/look-busy#readme",
  "bugs": {
    "url": "https://github.com/AbdullahHassan192/look-busy/issues"
  },
  "keywords": [
    "typing",
    "productivity",
    "funny",
    "monkeytype",
    "copilot",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:look-busy.start"
  ],
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "look-busy.start",
        "title": "Look Busy: Start Workspace Session"
      },
      {
        "command": "look-busy.panic",
        "title": "Look Busy: Panic"
      },
      {
        "command": "look-busy.injectText",
        "title": "Look Busy: Inject Text"
      },
      {
        "command": "look-busy.blockEdit",
        "title": "Look Busy: Block Edit"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "look-busy.blockEdit",
          "when": "false"
        },
        {
          "command": "look-busy.injectText",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "look-busy.start",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "look-busy.panic",
        "key": "escape",
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.injectText",
        "key": "enter",
        "args": {
          "text": "\n"
        },
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.injectText",
        "key": "shift+enter",
        "args": {
          "text": "\n"
        },
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.injectText",
        "key": "tab",
        "args": {
          "text": "\t"
        },
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "backspace",
        "args": {
          "action": "backspace"
        },
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "delete",
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "shift+insert",
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "lookBusy.active && editorTextFocus"
      },
      {
        "command": "look-busy.blockEdit",
        "key": "ctrl+y",
        "mac": "shift+cmd+z",
        "when": "lookBusy.active && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package:vsix": "vsce package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.115.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
